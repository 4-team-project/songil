<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.takku.project.mapper.TagMapper">

	<select id="selectTagNamesByFundingId" resultType="string"
		parameterType="int">
		SELECT t.tag_name
		FROM takku_tag t
		JOIN takku_funding_tag ft ON t.tag_id = ft.tag_id
		WHERE ft.funding_id = #{fundingId}
	</select>
</mapper>